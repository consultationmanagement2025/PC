# Email Configuration - COPY TO .env and fill in your values
EMAIL_USERNAME=consultationmanagement@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=Valenzuela City Government - Consultation System

# Application Configuration
APP_URL=https://consultation.spvalenzuela.com
APP_ENV=production
DEBUG=false

# Integration — set APP_URL to your live PCMS URL (used for peer API discovery)
# For subdomain deploy: APP_URL=https://pcms.yourdomain.com
# For folder deploy:     APP_URL=https://yourdomain.com/CAPSTONE-LIVE/PCMS

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=pc_db

# Optional override for local development
# ENVIRONMENT=development
