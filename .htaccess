# PCMS Root .htaccess for Live Deployment (Subdomain: consultation.spvalenzuela.com)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Enable Authorization Header passthrough for PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Case-insensitive API route rewrite for Linux / LiteSpeed
    RewriteRule ^api/v1/(.*)$ API/v1/$1 [L,QSA,NC]

    # 3. Block direct web access to sensitive DATABASE directory
    RewriteRule ^DATABASE/ - [F,L,NC]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# 4. Protect .env files from web download
<FilesMatch "^\.env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
